# Environment Configuration Example
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git - it's already in .gitignore

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================

# Remote server password (REQUIRED for deploy scripts)
# Get this from your server admin or password manager
# Example: REMOTE_PASS=your_secure_password_here
REMOTE_PASS=

# Remote server connection details
REMOTE_HOST=47.100.80.20
REMOTE_USER=root
REMOTE_PORT=22

# Application paths
APP_DIR=/opt/heartbeat
SERVICE_NAME=heartbeat

# Domain configuration
SERVER_NAME=live.tongjicdi.com
HTTPS_HOSTNAME=live.tongjicdi.com
CERTBOT_EMAIL=admin@tongjicdi.com

# =============================================================================
# CLOUDFLARE DNS-01 CERTIFICATE CONFIGURATION (Optional)
# =============================================================================
# Required for Let's Encrypt certificates when deploying to a domain
# Get these from your Cloudflare account dashboard

# Your Cloudflare account email
# CLOUDFLARE_EMAIL=your-email@example.com

# Your Cloudflare Global API Key (from https://dash.cloudflare.com/profile/api-tokens)
# CLOUDFLARE_API_KEY=your_global_api_key_here

# =============================================================================
# ADMIN INTERFACE CONFIGURATION
# =============================================================================

# Admin credentials for the web dashboard
HEARTBEAT_ADMIN_USER=admin
HEARTBEAT_ADMIN_PASS=change_this_default_password

# Flask secret key for session management
# Generate a secure random key with: openssl rand -hex 32
HEARTBEAT_SECRET_KEY=generate_a_secure_random_key_here

# =============================================================================
# OPTIONAL: SHARED SESSION DIRECTORY
# =============================================================================
# If you need to mirror session JSON files to an external location
# HEARTBEAT_SHARED_SESSION_DIR=/path/to/shared/sessions

# =============================================================================
# USAGE INSTRUCTIONS
# =============================================================================
#
# 1. Copy this file: cp .env.example .env
# 2. Edit .env and fill in your actual values
# 3. Source the file before running deploy scripts:
#    source .env
# 4. Or use with deploy scripts:
#    source .env && ./deploy.sh
#
# IMPORTANT: Never commit .env to git! It contains sensitive credentials.
